# Copy to .env and fill in
PORT=3000
DATABASE_URL=postgres://attendly:attendly@localhost:5432/attendly
# true when your hosted Postgres requires SSL (Render external URL, Neon, Supabase...)
DATABASE_SSL=false
JWT_SECRET=change-me-to-a-long-random-string
# set to false in production to skip demo data
SEED_DEMO=true
# only needed when the frontend is hosted on a different domain
CORS_ORIGIN=
